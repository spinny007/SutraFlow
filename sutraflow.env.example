# SutraFlow settings for the sutraflow launcher (bin/sutraflow, bin\sutraflow.cmd).
# Copied to sutraflow.env on first use; change that file, not this one. Lines are NAME=value.

# Where SutraFlow keeps its data: the SQLite database, master.key (the vault key), logs.
# Relative paths are inside the SutraFlow folder. Back this folder up, above all master.key.
SUTRA_DATA_DIR=data

# The studio and the Admin Console listen here. Keep 127.0.0.1 unless a proxy sits in front.
SUTRA_ADMIN_HOST=127.0.0.1

# Studio: designer, Admin Console, engine and gateway in one process.
STUDIO_PORT=4800
STUDIO_GATEWAY_HTTP=8080
STUDIO_GATEWAY_HTTPS=8443

# A headless engine beside the studio (sutraflow start engine), on the same database.
ENGINE_PORT=4801
ENGINE_GATEWAY_HTTP=9080
ENGINE_GATEWAY_HTTPS=9443

# What this server is for: development, test or production. Shown on every log line and audit entry;
# on production only administrators clear project logs. Empty = development (production for an engine).
SUTRA_ENVIRONMENT=development

# Database: empty = SQLite in the data folder. For PostgreSQL, stop SutraFlow, copy the data once with
#   sutraflow db copy --to postgres://postgres@127.0.0.1:5432/sutraflow
# and set the same address here.
SUTRA_DB=
# PostgreSQL queue notifications are enabled by default; polling remains the durable fallback.
# SUTRA_PG_NOTIFY=0

# Node.js: empty = the node that runs the launcher. Set a full path to use another one.
SUTRA_NODE=

# Any other SUTRA_ setting of the server can go here too, for example:
# SUTRA_WORKERS=16
# SUTRA_MASTER_KEY=        (base64, 32 bytes; instead of data/master.key)
