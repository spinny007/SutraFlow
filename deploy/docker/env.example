# SutraFlow (2.1.6): values for deploy/docker/compose.yml and compose.cluster.yml.
# Copy to .env, fill in, keep it private (never in Git). Back up SUTRA_MASTER_KEY: without it the
# vault (secret properties) cannot be read.

# The image: the official one, your registry's copy, or `sutraflow image build` (sutraflow:<version>).
SUTRA_IMAGE=ghcr.io/spinny007/sutraflow
SUTRA_VERSION=2.1.6

# The admin API token (the pipeline and `sutra --server` use it). openssl rand -hex 24
SUTRA_ADMIN_TOKEN=
# The vault key. openssl rand -base64 32
SUTRA_MASTER_KEY=
SUTRA_ENVIRONMENT=production

# Cluster only: the bundled PostgreSQL's password, or a managed database instead.
POSTGRES_PASSWORD=
# SUTRA_DB=postgres://sutra:password@db.example.internal:5432/sutra

# .sutra packages dropped here are deployed when an engine starts.
SUTRA_DEPLOY_FOLDER=./deploy-drop
