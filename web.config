<?xml version="1.0" encoding="utf-8"?>
<!--
  SutraFlow is a Node.js server with web servers of its own (studio 4800, gateway 8080/8443); IIS never
  serves this folder: only the page that says how to install and start SutraFlow. To reach SutraFlow
  through IIS, use Application Request Routing to forward a host name to its ports (user guide,
  "Install and start the server").
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="install-sutraflow.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <!-- Only the folder itself and install-sutraflow.html; every other file and folder is refused (404). -->
        <hiddenSegments>
          <add segment="sutraflow.env" />
          <add segment="data" />
          <add segment="backups" />
          <add segment="bin" />
          <add segment="dist" />
          <add segment="docs" />
          <add segment="deploy" />
          <add segment="samples" />
          <add segment="tools" />
          <add segment="vendor" />
          <add segment="node_modules" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="false">
          <add fileExtension="." allowed="true" />
          <add fileExtension=".html" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
