{
  "name": "sutraflow",
  "version": "2.1.0",
  "description": "SutraFlow: visual integration designer and engine (palettes, mapping, SOAP/WS-Security, REST, exposed secured APIs, TLS/Let's Encrypt).",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Surya Partap Singh",
  "repository": {
    "type": "git",
    "url": "https://github.com/spinny007/SutraFlow.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "vendor:check": "node tools/check-vendor.mjs",
    "vendor:check:online": "node tools/check-vendor.mjs --online",
    "vendor:lock": "node tools/check-vendor.mjs --write",
    "prebuild": "npm run vendor:check",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "vite build --config web/vite.config.ts && tsc -p server/tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/main.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "security": "npm audit --audit-level=high",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=2 --test-timeout=180000 test/*.test.ts",
    "test:samples": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 --test-timeout=180000 test/sample-consistency.test.ts test/sample-import.test.ts test/mapping207.test.ts test/validation-samples.test.ts",
    "guide": "tsx tools/build-user-guide.ts",
    "guide:shots": "node tools/capture-guide-shots.mjs",
    "architecture": "tsx tools/build-architecture.ts",
    "samples": "tsx tools/build-sample-projects.ts",
    "sutra": "node --disable-warning=ExperimentalWarning dist/server/cli.js",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/static": "^10.1.6",
    "@xmldom/xmldom": "^0.8.15",
    "acme-client": "file:vendor/acme-client",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^2.2.0",
    "basic-ftp": "^6.2.3",
    "croner": "^10.0.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "imapflow": "^2.4.0",
    "isomorphic-git": "^1.44.3",
    "jose": "^6.2.12",
    "jsonata": "^2.2.2",
    "kafkajs": "^2.2.4",
    "mailparser": "^3.9.38",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.6",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.0",
    "oracledb": "^26.0.0",
    "pg": "^8.23.1",
    "rhea": "^3.0.5",
    "selfsigned": "^5.5.0",
    "soap": "^1.14.0",
    "ssh2-sftp-client": "^11.0.0",
    "undici": "^8.11.2",
    "unpdf": "^1.9.0",
    "ws": "^8.22.0",
    "xml-crypto": "^6.3.3",
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@electric-sql/pglite-socket": "^0.0.22",
    "@types/amqplib": "^0.10.8",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "concurrently": "^10.0.6",
    "echarts": "^6.1.0",
    "ftp-srv": "file:vendor/ftp-srv",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smtp-server": "^3.19.21",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ssh2": false,
    "oracledb": false
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "@azure/msal-node": {
      "uuid": "11.1.1"
    }
  },
  "bin": {
    "sutra": "dist/server/cli.js",
    "sutraflow": "bin/sutraflow.mjs"
  }
}
